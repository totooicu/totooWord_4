<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.totoo.system.mapper.FunGroupMapper">
    
    <resultMap type="FunGroup" id="FunGroupResult">
        <result property="groupId"    column="group_id"    />
        <result property="groupName"    column="group_name"    />
        <result property="createUserId"    column="create_user_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="introduction"    column="introduction"    />
        <result property="avatarUrl"    column="avatar_url"    />
    </resultMap>

    <sql id="selectFunGroupVo">
        select group_id, group_name, create_user_id, create_time, introduction, avatar_url from fun_group
    </sql>

    <select id="selectFunGroupList" parameterType="FunGroup" resultMap="FunGroupResult">
        <include refid="selectFunGroupVo"/>
        <where>  
            <if test="groupName != null  and groupName != ''"> and group_name like concat('%', #{groupName}, '%')</if>
            <if test="createUserId != null "> and create_user_id = #{createUserId}</if>
            <if test="introduction != null  and introduction != ''"> and introduction = #{introduction}</if>
            <if test="avatarUrl != null  and avatarUrl != ''"> and avatar_url = #{avatarUrl}</if>
        </where>
    </select>
    
    <select id="selectFunGroupByGroupId" parameterType="Long" resultMap="FunGroupResult">
        <include refid="selectFunGroupVo"/>
        where group_id = #{groupId}
    </select>

    <insert id="insertFunGroup" parameterType="FunGroup" useGeneratedKeys="true" keyProperty="groupId">
        insert into fun_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupName != null and groupName != ''">group_name,</if>
            <if test="createUserId != null">create_user_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="introduction != null">introduction,</if>
            <if test="avatarUrl != null">avatar_url,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="groupName != null and groupName != ''">#{groupName},</if>
            <if test="createUserId != null">#{createUserId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="introduction != null">#{introduction},</if>
            <if test="avatarUrl != null">#{avatarUrl},</if>
         </trim>
    </insert>

    <update id="updateFunGroup" parameterType="FunGroup">
        update fun_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="groupName != null and groupName != ''">group_name = #{groupName},</if>
            <if test="createUserId != null">create_user_id = #{createUserId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="introduction != null">introduction = #{introduction},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
        </trim>
        where group_id = #{groupId}
    </update>

    <delete id="deleteFunGroupByGroupId" parameterType="Long">
        delete from fun_group where group_id = #{groupId}
    </delete>

    <delete id="deleteFunGroupByGroupIds" parameterType="String">
        delete from fun_group where group_id in 
        <foreach item="groupId" collection="array" open="(" separator="," close=")">
            #{groupId}
        </foreach>
    </delete>
</mapper>